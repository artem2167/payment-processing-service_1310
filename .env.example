#Тоолько для демонcтрации, и тестов. Для реального деплоя не использовать:)
API_KEY=dev-payments-api-key-change-before-sharing

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/

API_PORT=8000
WEBHOOK_RECEIVER_PORT=8080

RETRY_BASE_DELAY=5
WEBHOOK_TIMEOUT=10
OUTBOX_POLL_INTERVAL=0.5
PUBLISH_TIMEOUT=5
RECOVERY_DELAY=2
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
LOG_LEVEL=INFO
